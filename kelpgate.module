<?php

/**
 * @file
 * Primary module hooks for the Kelpgate Malware Scanner module.
 */

use Drupal\file\FileInterface;
use Drupal\file\Validation\FileValidationEvent;

/**
 * Implements hook_file_validate().
 *
 * Scans uploaded files on Drupal 9.5 to 10.1. Drupal 10.2 deprecated this hook in favour of
 * FileValidationEvent, which \Drupal\kelpgate\EventSubscriber\FileValidationSubscriber handles.
 * Drupal 10.2 and later 10.x releases invoke both, so the hook does nothing when the event exists
 * and each upload is scanned once. Drupal 11 no longer invokes the hook.
 */
function kelpgate_file_validate(FileInterface $file) {
  if (class_exists(FileValidationEvent::class)) {
    return [];
  }

  /** @var \Drupal\kelpgate\Scanner\KelpgateScanner $scanner */
  $scanner = \Drupal::service('kelpgate.scanner');
  $error = $scanner->validationError($file);

  return $error === NULL ? [] : [$error];
}
